{
  "id": "IOrnWq6h66gpuNT6",
  "name": "Phase 5 \u2014 Telegram Digest",
  "active": false,
  "nodes": [
    {
      "id": "n1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "15 */6 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "n2",
      "name": "Query Medium Signals",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        220,
        300
      ],
      "continueOnFail": true,
      "parameters": {
        "url": "={{ 'https://api.notion.com/v1/databases/' + $env.NOTION_DB_ID + '/query' }}",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.NOTION_API_KEY }}"
            },
            {
              "name": "Notion-Version",
              "value": "2022-06-28"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({filter: {and: [{property: 'Created At', date: {on_or_after: new Date(Date.now() - 6*60*60*1000).toISOString()}}, {property: 'Boosted Score', number: {greater_than_or_equal_to: 5}}, {property: 'Boosted Score', number: {less_than_or_equal_to: 7}}, {property: 'Alerted', checkbox: {equals: false}}]}, page_size: 100}) }}"
      }
    },
    {
      "id": "n3",
      "name": "Parse Digest Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst pages = [];\nfor (const item of items) {\n  const results = item.json.results || [];\n  for (const page of results) {\n    const props = page.properties || {};\n    const titleArr = props['Title'] && props['Title'].title ? props['Title'].title : [];\n    const draftArr = props['Draft Reply'] && props['Draft Reply'].rich_text ? props['Draft Reply'].rich_text : [];\n    pages.push({\n      json: {\n        page_id: page.id,\n        title: titleArr[0] ? titleArr[0].plain_text : '',\n        url: props['URL'] && props['URL'].url ? props['URL'].url : '',\n        source: props['Source'] && props['Source'].select ? props['Source'].select.name : '',\n        boosted_score: props['Boosted Score'] && props['Boosted Score'].number !== null ? props['Boosted Score'].number : 0,\n        draft_reply: draftArr[0] ? draftArr[0].plain_text : '',\n      }\n    });\n  }\n}\nreturn pages;"
      }
    },
    {
      "id": "n4",
      "name": "Format Digest Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nif (items.length === 0) return [];\n\nconst timestamp = new Date().toLocaleString('en-IN', {timeZone: 'Asia/Kolkata', dateStyle: 'medium', timeStyle: 'short'});\nconst lines = items.map(item => {\n  const p = item.json;\n  const reply = p.draft_reply ? `  \ud83d\udcac ${p.draft_reply}` : '';\n  return `\u2022 ${p.title} (${p.source}) \u2014 Score: ${p.boosted_score}${reply ? '\\n' + reply : ''}\\n  \ud83d\udd17 ${p.url}`;\n}).join('\\n\\n');\n\nconst message = `\ud83d\udcca Signal Digest \u2014 ${timestamp}\\n\\n${lines}\\n\\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\nTotal signals this batch: ${items.length}`;\n\nreturn [{ json: { message, count: items.length } }];"
      }
    },
    {
      "id": "n5",
      "name": "Telegram Send Digest",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.message }}",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "TELEGRAM_API"
        }
      }
    },
    {
      "id": "n6",
      "name": "Flatten for Mark Alerted",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const pages = $('Parse Digest Items').all();\nreturn pages.map(item => ({ json: { page_id: item.json.page_id } }));"
      }
    },
    {
      "id": "n7",
      "name": "Update Alerted Flag",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1320,
        300
      ],
      "continueOnFail": true,
      "parameters": {
        "url": "={{ 'https://api.notion.com/v1/pages/' + $json.page_id }}",
        "method": "PATCH",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.NOTION_API_KEY }}"
            },
            {
              "name": "Notion-Version",
              "value": "2022-06-28"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({properties: {Alerted: {checkbox: true}}}) }}"
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Query Medium Signals",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Medium Signals": {
      "main": [
        [
          {
            "node": "Parse Digest Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Digest Items": {
      "main": [
        [
          {
            "node": "Format Digest Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Digest Message": {
      "main": [
        [
          {
            "node": "Telegram Send Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram Send Digest": {
      "main": [
        [
          {
            "node": "Flatten for Mark Alerted",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Flatten for Mark Alerted": {
      "main": [
        [
          {
            "node": "Update Alerted Flag",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  }
}